---
import { BASE } from '@/consts';

interface Props {
  number: string;
  tag: string;
  title: string;
  subtitle: string;
  cover: string;
  thumbnail?: string;
  coverVideo?: string;
  metric: string;
  slug: string;
  index: number;
  comingSoon?: boolean;
}

const { number, tag, title, subtitle, cover, thumbnail, coverVideo, metric, slug, comingSoon = false } = Astro.props;
const href = `${BASE}/cases/${slug}`;
const imgSrc = BASE + (thumbnail ?? cover);
const videoSrc = coverVideo ? BASE + coverVideo : undefined;
---

<article class="hairline-card case-card" style={comingSoon ? 'opacity: 0.6;' : undefined}>
  <!-- Case image -->
  {comingSoon ? (
    <div style="display: block; position: relative; border-bottom: 1px solid var(--border);">
      <div class="img-placeholder" style="width: 100%; aspect-ratio: 4/3; border: none; border-radius: 0;">
        <img
          src={imgSrc}
          alt={`${title} screenshot`}
          style="width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; z-index: 2;"
          onerror="this.style.display='none';"
          loading="lazy"
        />
        <span>{title} — screenshot placeholder</span>
      </div>
    </div>
  ) : (
    <a href={href} style="display: block; position: relative; border-bottom: 1px solid var(--border);" aria-label={`Abrir case: ${title}`}>
      <div class="img-placeholder case-img-hover" style="width: 100%; aspect-ratio: 4/3; border: none; border-radius: 0;">
        {videoSrc ? (
          <video
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
            poster={imgSrc}
            aria-label={`${title} — preview`}
            style="width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; z-index: 2; transition: transform var(--dur-long) var(--ease-out);"
          >
            <source src={videoSrc} type="video/mp4" />
            <img src={imgSrc} alt={`${title} screenshot`} style="width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; z-index: 2;" />
          </video>
        ) : (
          <img
            src={imgSrc}
            alt={`${title} screenshot`}
            style="width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; z-index: 2; transition: transform var(--dur-long) var(--ease-out);"
            onerror="this.style.display='none';"
            loading="lazy"
          />
        )}
        <span>{title} — screenshot placeholder</span>
      </div>
    </a>
  )}

  <div style="padding: var(--space-md);">
    <!-- Top row: tag + status -->
    <div style="display: flex; align-items: center; justify-content: space-between; gap: var(--space-xs); margin-bottom: var(--space-sm);">
      <span style="font-family: var(--font-mono); font-size: 0.62rem; color: var(--muted-foreground); letter-spacing: 0.08em; text-transform: uppercase;">
        {tag}
      </span>
      {comingSoon ? (
        <span style="font-family: var(--font-mono); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.1em; color: var(--muted-foreground); text-transform: uppercase; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.2em 0.55em;">
          EM BREVE
        </span>
      ) : (
        <span style="font-family: var(--font-mono); font-size: 0.62rem; color: var(--accent); font-weight: 700; letter-spacing: 0.06em;">
          {number}
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 style="font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; line-height: 1.2; letter-spacing: -0.01em; color: var(--foreground); margin-bottom: var(--space-2xs);">
      {title}
    </h3>

    <!-- Subtitle -->
    <p style="font-family: var(--font-sans); font-size: 0.8rem; color: var(--muted-foreground); line-height: 1.55; margin-bottom: var(--space-md);">
      {subtitle}
    </p>

    <!-- Bottom row: metric + link -->
    <div style="display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-sm); border-top: 1px solid var(--border); padding-top: var(--space-sm);">
      <p class="tabular-nums" style="font-family: var(--font-mono); font-size: 0.68rem; color: var(--muted-foreground); letter-spacing: 0.02em;">
        {metric}
      </p>
      {!comingSoon && (
        <a
          href={href}
          class="underline-hover"
          style="font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; color: var(--foreground); text-decoration: none; text-transform: uppercase; white-space: nowrap;"
        >
          Ver case →
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .case-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
  }

  .case-img-hover img:hover,
  .case-img-hover video:hover {
    transform: scale(1.02);
  }
</style>
