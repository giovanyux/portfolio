---
import { BASE } from '@/consts';

interface Props {
  number: string;
  tag: string;
  title: string;
  subtitle: string;
  cover: string;
  thumbnail?: string;
  coverVideo?: string;
  metric: string;
  slug: string;
  index: number;
  comingSoon?: boolean;
}

const { number, tag, title, subtitle, cover, thumbnail, coverVideo, metric, slug, comingSoon = false } = Astro.props;
const href = `${BASE}/cases/${slug}`;
const imgSrc = BASE + (thumbnail ?? cover);
const videoSrc = coverVideo ? BASE + coverVideo : undefined;
---

<article
  class="hairline-card case-card"
  style={comingSoon ? 'opacity: 0.6;' : undefined}
  data-cursor-label={comingSoon ? undefined : 'Ver case →'}
>
  <!-- Case image — plain (não-link): o card inteiro é a área de clique,
       via o link único ancorado no título (ver .case-card-link abaixo).
       data-cursor-label no <article> (não só no <a> do título) é o que
       faz o rótulo do cursor aparecer em cima do card inteiro — a área de
       clique real também é o card inteiro (stretched-link), então o
       cursor precisa bater com isso, não só com o texto do título. -->
  <div style="display: block; position: relative; border-bottom: 1px solid var(--border);">
    <div class={comingSoon ? 'img-placeholder' : 'img-placeholder case-img-hover'} style="width: 100%; aspect-ratio: 4/3; border: none; border-radius: 0;">
      {videoSrc ? (
        <video
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          poster={imgSrc}
          aria-label={`${title}: preview`}
          style="width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; z-index: 2; transition: transform var(--dur-long) var(--ease-out);"
        >
          <source src={videoSrc} type="video/mp4" />
          <img src={imgSrc} alt={`${title} screenshot`} style="width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; z-index: 2;" />
        </video>
      ) : (
        <img
          src={imgSrc}
          alt={`${title} screenshot`}
          style="width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; z-index: 2; transition: transform var(--dur-long) var(--ease-out);"
          onerror="this.style.display='none';"
          loading="lazy"
        />
      )}
      <span>{title}: screenshot placeholder</span>
    </div>
  </div>

  <div style="padding: var(--space-md);">
    <!-- Top row: tag + status -->
    <div style="display: flex; align-items: center; justify-content: space-between; gap: var(--space-xs); margin-bottom: var(--space-sm);">
      <span style="font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-muted); letter-spacing: 0.08em; text-transform: uppercase;">
        {tag}
      </span>
      {comingSoon ? (
        <span style="font-family: var(--font-mono); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.1em; color: var(--text-muted); text-transform: uppercase; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.2em 0.55em;">
          EM BREVE
        </span>
      ) : (
        <span style="font-family: var(--font-mono); font-size: 0.62rem; color: var(--action); font-weight: 700; letter-spacing: 0.06em;">
          {number}
        </span>
      )}
    </div>

    <!-- Title — o único <a> real do card. Um pseudo-elemento (.case-card-link::after)
         estica a área de clique pro card inteiro, então não há <a> aninhado. -->
    <h3 style="font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; line-height: 1.2; letter-spacing: -0.01em; margin-bottom: var(--space-2xs);">
      {comingSoon ? (
        <span style="color: var(--text);">{title}</span>
      ) : (
        <a href={href} class="case-card-link">{title}</a>
      )}
    </h3>

    <!-- Subtitle -->
    <p style="font-family: var(--font-sans); font-size: 0.8rem; color: var(--text-muted); line-height: 1.55; margin-bottom: var(--space-md);">
      {subtitle}
    </p>

    <!-- Bottom row: metric + link -->
    <div style="display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-sm); border-top: 1px solid var(--border); padding-top: var(--space-sm);">
      <p class="tabular-nums" style="font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-muted); letter-spacing: 0.02em;">
        {metric}
      </p>
      {!comingSoon && (
        <span
          aria-hidden="true"
          style="font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; color: var(--text); text-transform: uppercase; white-space: nowrap;"
        >
          Ver case →
        </span>
      )}
    </div>
  </div>
</article>

<style>
  .case-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    position: relative; /* ancora o ::after do stretched-link */
  }

  /* Hover do zoom da imagem agora escuta o card inteiro, não só a própria
     mídia — porque o clique/hover real acontece na camada do link
     (z-index acima da imagem), não na imagem em si. */
  .case-card:hover .case-img-hover img,
  .case-card:hover .case-img-hover video {
    transform: scale(1.02);
  }

  /* Action-colour signal on hover — cards are the one clickable surface
     where the border flashes --action instead of the generic --border-strong. */
  .case-card:hover {
    border-color: var(--action);
  }

  /* Stretched link: o <a> real fica só no título, mas ::after cobre o
     card inteiro (z-index acima da mídia, que usa z-index: 2) — assim
     clicar em qualquer ponto do card (imagem, subtítulo, métrica) navega
     pro case, sem precisar de <a> aninhado. */
  .case-card-link {
    color: var(--text);
    text-decoration: none;
  }

  .case-card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
  }

  .case-card-link:focus-visible {
    outline: none;
  }

  .case-card-link:focus-visible::after {
    outline: 2px solid var(--action);
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }
</style>
