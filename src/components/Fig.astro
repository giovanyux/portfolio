---
import { BASE } from '@/consts';

interface Props {
  number: string;
  src: string;
  alt: string;
  caption?: string;
}

const { number, src, alt, caption } = Astro.props;
---

<figure data-reveal="scroll" style="margin: 3rem 0;">
  <div class="img-placeholder" style="width: 100%; aspect-ratio: 16/9;">
    <img
      src={BASE + src}
      alt={alt}
      style="width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; z-index: 2;"
      onerror="this.style.display='none';"
      loading="lazy"
    />
    <span>{alt}</span>
  </div>
  <figcaption style="font-family: var(--font-mono); font-size: 0.6rem; color: var(--text-muted); letter-spacing: 0.06em; margin-top: 0.5rem; text-align: center;">
    Fig. {number}{caption ? ` — ${caption}` : ''}
  </figcaption>
</figure>