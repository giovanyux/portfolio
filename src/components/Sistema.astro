---
import { BASE } from '@/consts';

interface Screen {
  src: string;
  caption: string;
}

interface Props {
  screens: Screen[];
}

const { screens } = Astro.props;
---

<div data-reveal="scroll" class="sistema-grid">
  {screens.map((screen) => (
    <figure class="sistema-item">
      <div class="img-placeholder" style="width: 100%; aspect-ratio: 4/3;">
        <img
          src={BASE + screen.src}
          alt={screen.caption}
          style="width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; z-index: 2;"
          onerror="this.style.display='none';"
          loading="lazy"
        />
        <span>{screen.caption}</span>
      </div>
      <figcaption style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-muted); margin-top: 0.5rem; line-height: 1.4;">
        {screen.caption}
      </figcaption>
    </figure>
  ))}
</div>

<style>
  .sistema-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin: 2.5rem 0;
    width: min(860px, calc(100vw - 4rem));
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }

  @media (max-width: 767px) {
    .sistema-grid {
      grid-template-columns: repeat(2, 1fr);
      width: 100%;
      left: 0;
      transform: none;
    }
  }
</style>