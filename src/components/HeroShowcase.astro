---
// Vitrine de telas do hero: cada case entra na sua própria moldura de
// device — desktop num card, mobile num frame de phone — compostas em
// profundidade quando o case tem as duas. Contenção é a regra número um: a
// coluna de mídia tem overflow:hidden e todo frame é limitado por
// max-width/max-height (não largura OU altura fixa), então nenhuma mídia,
// nenhuma proporção, pode vazar pra cima da coluna de texto — foi
// exatamente esse vazamento que quebrou o hero antes. Curadoria em
// src/data/hero-showcase.ts.
import { BASE } from '@/consts';
import { HERO_SHOWCASE } from '@/data/hero-showcase';
import { getImageDimensions } from '@/lib/image-dimensions';
import path from 'node:path';

function resolveMedia(media?: { src: string; alt: string }) {
  if (!media) return undefined;
  const dims = getImageDimensions(path.join(process.cwd(), 'public', media.src));
  return {
    src: `${BASE}${media.src}`,
    alt: media.alt,
    width: dims?.width,
    height: dims?.height,
  };
}

const items = HERO_SHOWCASE.map((entry) => ({
  caseSlug: entry.caseSlug,
  caseTitle: entry.caseTitle,
  href: `${BASE}/cases/${entry.caseSlug}`,
  desktop: resolveMedia(entry.desktop),
  mobile: resolveMedia(entry.mobile),
}));

const first = items[0];
---

<a
  href={first?.href}
  class="hero-showcase"
  id="hero-showcase"
  data-cursor-label="Ver case →"
  aria-label={`Ver case: ${first?.caseTitle ?? ''}`}
>
  <div class="hero-showcase-stage">
    <!-- Cena 0 renderizada no servidor (não via JS) — LCP correto e o hero
         nunca fica em branco sem JS. As demais cenas da rotação são
         construídas no client script, ver buildScene(). -->
    <div id="hero-showcase-a" class="showcase-scene is-active">
      {first?.desktop && (
        <div
          class="showcase-frame showcase-frame--desktop"
          style={first.desktop.width && first.desktop.height ? `aspect-ratio: ${first.desktop.width} / ${first.desktop.height};` : undefined}
        >
          <img
            src={first.desktop.src}
            alt={first.desktop.alt}
            width={first.desktop.width}
            height={first.desktop.height}
            loading="eager"
          />
        </div>
      )}
      {first?.mobile && (
        <div
          class={`showcase-frame showcase-frame--mobile ${first.desktop ? 'is-layered' : 'is-solo'}`}
          style={first.mobile.width && first.mobile.height ? `aspect-ratio: ${first.mobile.width} / ${first.mobile.height};` : undefined}
        >
          <img
            src={first.mobile.src}
            alt={first.mobile.alt}
            width={first.mobile.width}
            height={first.mobile.height}
            loading="eager"
          />
        </div>
      )}
    </div>
    <div id="hero-showcase-b" class="showcase-scene"></div>
  </div>
</a>

<script type="application/json" id="hero-showcase-data" set:html={JSON.stringify(items)} />

<style>
  .hero-showcase {
    display: block;
    position: relative;
    min-width: 0; /* pra caber num grid track sem forçar overflow na coluna */
  }

  /* Área reservada (evita CLS entre cenas) E limite físico da coluna de
     mídia — overflow:hidden é o que garante, sem exceção, que nada
     ultrapasse essa caixa em direção ao texto. */
  .hero-showcase-stage {
    position: relative;
    aspect-ratio: 5 / 6;
    overflow: hidden;
  }

  .showcase-scene {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
  }

  .showcase-scene.is-active {
    opacity: 1;
  }

  /* Base comum: todo frame é limitado por max-width/max-height (nunca
     width/height fixos) — regardless da proporção real da imagem, o frame
     nunca cresce além desses limites. aspect-ratio (setado inline, exato,
     por imagem) faz width/height auto se resolverem juntos preservando a
     proporção, então "caber no limite" nunca distorce nem corta. */
  /* :global() nessas classes de frame: a cena 0 vem do servidor (tem o
     atributo de scoping do Astro), mas as cenas seguintes da rotação são
     criadas via document.createElement no client script — sem :global()
     essas regras não bateriam nelas. */
  :global(.showcase-frame) {
    position: absolute;
    width: auto;
    height: auto;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface);
  }

  :global(.showcase-frame img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.showcase-frame--desktop) {
    top: 6%;
    left: 0;
    max-width: 74%;
    max-height: 62%;
    border: 1px solid var(--border);
    box-shadow: 0 24px 48px -20px color-mix(in oklch, var(--text) 42%, transparent);
  }

  :global(.showcase-frame--mobile) {
    border-radius: 22px;
    border: 3px solid var(--surface);
    outline: 1px solid var(--border);
    box-shadow: 0 20px 40px -16px color-mix(in oklch, var(--text) 46%, transparent);
  }

  /* composição em profundidade: mobile sobreposto ao desktop, canto
     inferior direito, leve rotação — o tratamento preferido. Ainda dentro
     dos limites da caixa (right/bottom positivos, nunca negativos). */
  :global(.showcase-frame--mobile.is-layered) {
    right: 4%;
    bottom: 3%;
    max-width: 46%;
    max-height: 54%;
    transform: rotate(-4deg);
    z-index: 2;
  }

  /* case sem desktop (ex.: PJBank): mobile sozinho, centralizado, maior —
     mas ainda contido pelos próprios limites, nunca cresce sem teto. */
  :global(.showcase-frame--mobile.is-solo) {
    left: 50%;
    top: 50%;
    max-width: 62%;
    max-height: 88%;
    transform: translate(-50%, -50%) rotate(-2deg);
  }

  /* Mobile do site (empilhado, uma coluna): mídia abaixo do texto, nunca
     sobre ele — o grid já resolve isso (ver .home-hero-layout em
     index.astro), aqui só ajusta proporções pra não haver overflow lateral
     nem quadro raso demais. */
  @media (max-width: 640px) {
    .hero-showcase-stage { aspect-ratio: 4 / 5; }
    :global(.showcase-frame--desktop) { max-width: 80%; max-height: 58%; }
    :global(.showcase-frame--mobile.is-layered) { max-width: 48%; max-height: 50%; }
    :global(.showcase-frame--mobile.is-solo) { max-width: 68%; max-height: 84%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-scene { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    if (window.__heroShowcaseInitialized) return;
    window.__heroShowcaseInitialized = true;

    var timerId = null;
    var resumeFn = null;

    function stop() {
      if (timerId !== null) {
        clearInterval(timerId);
        timerId = null;
      }
    }

    function buildFrame(media, extraClass) {
      var frame = document.createElement('div');
      frame.className = 'showcase-frame ' + extraClass;
      if (media.width && media.height) {
        frame.style.aspectRatio = media.width + ' / ' + media.height;
      }
      var img = document.createElement('img');
      img.src = media.src;
      img.alt = media.alt;
      if (media.width) img.width = media.width;
      if (media.height) img.height = media.height;
      img.loading = 'eager';
      img.decoding = 'async';
      frame.appendChild(img);
      return frame;
    }

    function buildScene(entry) {
      var frag = document.createDocumentFragment();
      if (entry.desktop) {
        frag.appendChild(buildFrame(entry.desktop, 'showcase-frame--desktop'));
      }
      if (entry.mobile) {
        var mobileClass = 'showcase-frame--mobile ' + (entry.desktop ? 'is-layered' : 'is-solo');
        frag.appendChild(buildFrame(entry.mobile, mobileClass));
      }
      return frag;
    }

    function initHeroShowcase() {
      stop();
      resumeFn = null;

      var root = document.getElementById('hero-showcase');
      var dataEl = document.getElementById('hero-showcase-data');
      if (!root || !dataEl) return;

      var items;
      try {
        items = JSON.parse(dataEl.textContent);
      } catch (e) {
        return;
      }
      if (!items || !items.length) return;

      var sceneA = document.getElementById('hero-showcase-a');
      var sceneB = document.getElementById('hero-showcase-b');
      // Cena A (índice 0) já vem renderizada do servidor — não reconstrói,
      // só as próximas cenas da rotação passam pelo buildScene().

      if (items.length < 2) return; // 1 case só: fica parado, sem rotação

      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reducedMotion) return; // primeira cena fica estática

      var active = sceneA;
      var hidden = sceneB;
      var index = 0;
      var paused = false;
      var DWELL_MS = 4800;
      var CROSSFADE_MS = 700;

      function nextIndex() {
        return (index + 1) % items.length;
      }

      function preloadNext() {
        hidden.innerHTML = '';
        hidden.appendChild(buildScene(items[nextIndex()]));
      }

      function crossfade() {
        index = nextIndex();
        var current = items[index];

        active.classList.remove('is-active');
        hidden.classList.add('is-active');

        var tmp = active;
        active = hidden;
        hidden = tmp;

        root.href = current.href;
        root.setAttribute('aria-label', 'Ver case: ' + current.caseTitle);

        setTimeout(preloadNext, CROSSFADE_MS);
      }

      function tick() {
        if (!paused) crossfade();
      }

      function start() {
        stop();
        timerId = setInterval(tick, DWELL_MS);
      }

      preloadNext();
      start();
      resumeFn = start;

      root.addEventListener('mouseenter', function () { paused = true; });
      root.addEventListener('mouseleave', function () { paused = false; });
      root.addEventListener('focusin', function () { paused = true; });
      root.addEventListener('focusout', function () { paused = false; });
    }

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) {
        stop();
      } else if (resumeFn) {
        resumeFn();
      }
    });

    document.addEventListener('astro:page-load', initHeroShowcase);
  })();
</script>
