---
import { SOCIAL } from '@/consts';
---

<div
  data-reveal="scroll"
  class="hairline-card"
  style="margin-top: var(--space-2xl); padding: var(--space-lg); background: var(--surface);"
>
  <p style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.12em; color: var(--action); text-transform: uppercase; margin-bottom: var(--space-sm); font-weight: 700;">
    Gostou do processo?
  </p>
  <p style="font-family: var(--font-sans); font-size: 1.0625rem; line-height: 1.6; color: var(--text); max-width: 60ch; margin-bottom: var(--space-md);">
    Esse é o tipo de problema que eu gosto de resolver. Se você tem um desafio
    parecido, ou só quer trocar uma ideia sobre o processo, me chama.
  </p>
  <a href={SOCIAL.email} class="btn-primary">
    Entrar em contato →
  </a>
</div>
