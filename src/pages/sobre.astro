---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GridLines from '@/components/GridLines.astro';

const experience = [
  {
    company: 'CARDÁPIO WEB',
    role: 'Líder Designer de Produto',
    years: 'AGO 2025 — JUN 2026',
    desc: 'Liderança de toda a frente de design em plataforma SaaS food service. Redesign B2B (+13k clientes pagantes), melhorias B2C (+1M usuários) e lançamento do totem de auto-atendimento.',
  },
  {
    company: 'GUPY',
    role: 'Designer de Produto Sr (Designer III)',
    years: 'MAI 2024 — JAN 2025',
    desc: 'Redesign do sistema de gerenciamento de vagas: +40% na taxa de aplicações e -30% no tempo de preenchimento. Lançamento de 3 novas funcionalidades estratégicas.',
  },
  {
    company: 'CLIQX',
    role: 'Designer de Produto Sr',
    years: 'MAR 2023 — MAR 2024',
    desc: 'Design Ops e product design em 4 squads. Padronização de documentação com redução de 50% no onboarding. Redesenho de fluxos de chatbot e auto-atendimento.',
  },
  {
    company: 'SUPERLOGICA',
    role: 'Designer de Produto Sr',
    years: 'JUN 2022 — FEV 2023',
    desc: 'Produtos financeiros que atingiram 120% das OKRs trimestrais. Pesquisa com usuários e parceria com growth para +25% de conversão.',
  },
  {
    company: 'GRUPO SALTA',
    role: 'Designer de Produto Sr',
    years: 'AGO 2021 — MAI 2022',
    desc: 'Liderança em discovery para 3 novos produtos digitais. Facilitação de workshops de Design Thinking. +70% dos OKRs atingidos.',
  },
  {
    company: 'AGENDA EDU',
    role: 'Designer de Produto Pleno',
    years: 'JAN 2021 — AGO 2021',
    desc: 'Design system unificado web e app. Redesenho de fluxos críticos baseado em analytics. Sistema de gestão escolar e aplicativo de pagamentos.',
  },
  {
    company: 'INTMED',
    role: 'Designer de Produto Jr',
    years: 'NOV 2017 — DEZ 2020',
    desc: 'Primeiro designer da empresa. 9 projetos entregues para a Hapvida (emergência, clínica, batimentos fetais). Fundação do time de design.',
  },
];

const focusAreas = [
  {
    num: '01',
    title: 'Product Design',
    desc: 'Visão end-to-end de produto. Do entendimento do problema e discovery até a entrega e iteração.',
  },
  {
    num: '02',
    title: 'Design Systems',
    desc: 'Arquiteturas token-first, governança de componentes, Storybook e alinhamento design/código.',
  },
  {
    num: '03',
    title: 'Workflow com IA',
    desc: 'Claude, Cursor e prompts customizados no dia a dia — da síntese de pesquisa à prototipagem.',
  },
];

const tools = ['FIGMA', 'FIGMA MCP', 'CLAUDE', 'CLAUDE CODE', 'CURSOR', 'DOVETAIL', 'MAZE', 'HOTJAR', 'MIXPANEL', 'SEMRUSH', 'STORYBOOK', 'SHADCN/UI', 'ASTRO', 'TAILWIND', 'NOTION', 'GITHUB'];
---

<BaseLayout
  title="Sobre — Giovany Jr"
  description="Lead product designer com 9 anos. Baseado em Fortaleza, Brasil. Aberto a posições sênior/lead, remote-first."
>

  <!-- ── HERO ──────────────────────────────────────────── -->
  <section style="position: relative; overflow: hidden; padding: 5rem 2rem 6rem; max-width: 1200px; margin: 0 auto;">
    <GridLines />
    <div style="position: relative; z-index: 1;">
      <p data-reveal="hero" style="font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 1.5rem;">
        SOBRE
      </p>
      <h1 data-reveal="hero" style="font-family: var(--font-mono); font-size: clamp(3rem, 8vw, 7rem); font-weight: 700; letter-spacing: -0.04em; line-height: 0.95; margin-bottom: 1.5rem; transition-delay: 120ms;">
        Olá, sou Giovany.
      </h1>
      <p data-reveal="hero" style="font-family: var(--font-mono); font-size: 1rem; color: var(--muted-foreground); transition-delay: 240ms;">
        Lead product designer baseado em Fortaleza, Brasil.
      </p>
    </div>
  </section>

  <!-- ── BIO ───────────────────────────────────────────── -->
  <section style="max-width: 1200px; margin: 0 auto; padding: 0 2rem 5rem;">
    <div style="max-width: 640px;">
      {[
        'Nove anos desenhando produtos digitais. Comecei em SaaS médico como UI designer e cresci até liderar design de plataformas em escala.',
        'Meu trabalho mais recente foi food-tech, software operacional que faz restaurante funcionar. Interface que aguenta pressão. Cozinha barulhenta. Mãos ocupadas. Operador com 30 segundos pra decidir.',
        'Nos últimos dois anos integrei IA em todas as fases do meu trabalho. Claude pra síntese de pesquisa e escrita. Cursor pra prototipagem com código real. Claude Code pra construir projetos inteiros, como este portfólio. Não é atalho. É multiplicador de capacidade.',
        'Procuro posição senior ou lead em product design, remote, em produto com complexidade operacional de verdade.',
      ].map((para) => (
        <p style="font-family: var(--font-mono); font-size: 0.95rem; line-height: 1.85; color: var(--muted-foreground); margin-bottom: 1.25rem;">
          {para}
        </p>
      ))}
    </div>
  </section>

  <!-- ── EXPERIÊNCIA ────────────────────────────────────── -->
  <section style="max-width: 1200px; margin: 0 auto; padding: 0 2rem 5rem; border-top: 1px solid var(--border);">
    <h2 style="font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-foreground); padding: 3rem 0 2rem;">Experiência</h2>

    {experience.map((item) => (
      <div
        style="border-top: 1px solid var(--border); padding: 1.5rem 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: baseline;"
      >
        <div>
          <p style="font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; color: var(--foreground); margin-bottom: 0.25rem;">{item.company}</p>
          <p style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--accent); letter-spacing: 0.04em;">{item.role}</p>
        </div>
        <div>
          <p style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--muted-foreground); letter-spacing: 0.08em; margin-bottom: 0.375rem;">{item.years}</p>
          <p style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted-foreground); line-height: 1.6;">{item.desc}</p>
        </div>
      </div>
    ))}
    <div style="border-top: 1px solid var(--border);"></div>
  </section>

  <!-- ── ÁREAS DE FOCO ──────────────────────────────────── -->
  <section style="max-width: 1200px; margin: 0 auto; padding: 0 2rem 5rem; border-top: 1px solid var(--border);">
    <h2 style="font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-foreground); padding: 3rem 0 2rem;">Áreas de foco</h2>

    <div data-reveal="scroll" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0; border: 1px solid var(--border);">
      {focusAreas.map((area, i) => (
        <div
          style={`padding: 2rem; ${i < focusAreas.length - 1 ? 'border-right: 1px solid var(--border);' : ''}`}
        >
          <p style="font-family: var(--font-mono); font-size: 0.6rem; color: var(--accent); font-weight: 700; letter-spacing: 0.1em; margin-bottom: 1rem;">{area.num}</p>
          <h3 style="font-family: var(--font-mono); font-size: 0.9rem; font-weight: 700; color: var(--foreground); margin-bottom: 0.75rem; letter-spacing: -0.01em;">{area.title}</h3>
          <p style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted-foreground); line-height: 1.7;">{area.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── FERRAMENTAS ────────────────────────────────────── -->
  <section style="max-width: 1200px; margin: 0 auto; padding: 0 2rem 6rem; border-top: 1px solid var(--border);">
    <h2 style="font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-foreground); padding: 3rem 0 2rem;">Ferramentas</h2>
    <p style="font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em; color: var(--muted-foreground);">
      {tools.join(' · ')}
    </p>
  </section>

</BaseLayout>
