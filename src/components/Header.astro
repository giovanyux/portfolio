---
import ThemeToggle from './ThemeToggle.astro';
import CommandPalette from './CommandPalette.astro';
import Logo from './Logo.astro';
import { NAV_LINKS, AUTHOR, BASE } from '@/consts';
import { getCollection } from 'astro:content';

const currentPath = Astro.url.pathname;

const cases = await getCollection('cases', ({ data }) => !data.draft && !data.comingSoon);
const cmdkItems = [
  { label: 'Home', href: `${BASE}/`, group: 'PÁGINA' },
  ...NAV_LINKS.map(({ href, label }) => ({ label: label.charAt(0) + label.slice(1).toLowerCase(), href, group: 'PÁGINA' })),
  ...cases
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .map((c) => ({ label: c.data.title, href: `${BASE}/cases/${c.slug}`, group: 'CASE' })),
];
---

<header id="site-header" style="
  position: sticky;
  top: 0;
  z-index: var(--z-sticky);
  border-bottom: 1px solid var(--border);
  background: var(--bg);
">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 2rem; height: 56px; display: flex; align-items: center; justify-content: space-between; gap: 2rem;">

    <!-- Logo -->
    <a
      href={`${BASE}/`}
      style="display: flex; align-items: center; flex-shrink: 0; transition: opacity var(--dur-short) var(--ease-out);"
      class="logo-link"
      aria-label={`${AUTHOR.short}: home`}
    >
      <Logo size={28} />
    </a>

    <!-- Nav desktop -->
    <nav aria-label="Main navigation" style="display: flex; align-items: center; gap: 0.25rem;">
      {NAV_LINKS.map(({ href, label }) => {
        const isActive = currentPath.startsWith(href);
        return (
          <a
            href={href}
            style={`
              font-family: var(--font-sans);
              font-size: 0.72rem;
              font-weight: 600;
              letter-spacing: 0.08em;
              text-transform: uppercase;
              padding: 0.375rem 0.75rem;
              text-decoration: none;
              transition: color var(--dur-short) var(--ease-out);
              color: ${isActive ? 'var(--text)' : 'var(--text-muted)'};
              ${isActive ? 'font-weight: 700;' : ''}
            `}
            aria-current={isActive ? 'page' : undefined}
          >
            {label}
          </a>
        );
      })}
    </nav>

    <!-- Right controls -->
    <div style="display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0;">
      <CommandPalette items={cmdkItems} />
      <ThemeToggle />

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        aria-label="Toggle menu"
        aria-expanded="false"
        style="
          display: none;
          background: none;
          border: none;
          cursor: pointer;
          color: var(--text-muted);
          font-family: var(--font-sans);
          font-weight: 600;
          font-size: 0.72rem;
          letter-spacing: 0.08em;
          text-transform: uppercase;
        "
      >
        MENU
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <div
    id="mobile-nav"
    style="
      display: none;
      border-top: 1px solid var(--border);
      background: var(--bg);
      padding: 1rem 2rem;
      flex-direction: column;
      gap: 0;
    "
  >
    {NAV_LINKS.map(({ href, label }) => (
      <a
        href={href}
        style="
          font-family: var(--font-sans);
          font-size: 0.78rem;
          letter-spacing: 0.06em;
          text-transform: uppercase;
          font-weight: 600;
          color: var(--text-muted);
          text-decoration: none;
          padding: 0.875rem 0;
          border-bottom: 1px solid var(--border);
        "
      >
        {label}
      </a>
    ))}
  </div>
</header>

<style>
  @media (max-width: 640px) {
    #mobile-menu-btn { display: block !important; }
    nav[aria-label="Main navigation"] { display: none !important; }
  }

  .logo-link:hover { opacity: 0.7; }

  #cmdk-trigger:hover,
  #cmdk-trigger:focus-visible {
    border-color: var(--action);
    color: var(--action);
  }
</style>

<script is:inline>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const nav = document.getElementById('mobile-nav');
    if (!btn || !nav) return;
    btn.addEventListener('click', () => {
      const open = nav.style.display === 'flex';
      nav.style.display = open ? 'none' : 'flex';
      btn.setAttribute('aria-expanded', String(!open));
      btn.textContent = open ? 'MENU' : 'CLOSE';
    });
  }
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
