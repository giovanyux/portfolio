---
import { BASE } from '@/consts';

interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<span class="logo-mark" style={`width:${size}px;height:${size}px;`}>
  <img
    class="logo-poster"
    src={`${BASE}/brand/logo-poster.webp`}
    alt=""
    width={size}
    height={size}
    decoding="async"
  />
  <video
    class="logo-video"
    autoplay
    loop
    muted
    playsinline
    preload="metadata"
    poster={`${BASE}/brand/logo-poster.webp`}
    aria-hidden="true"
  >
    <source src={`${BASE}/brand/logo.webm`} type="video/webm" />
    <source src={`${BASE}/brand/logo.mp4`} type="video/mp4" />
  </video>
  <svg class="logo-glyph" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M39.8008 17.1667C38.4248 7.46283 30.0839 0 20 0C8.95434 0 0 8.95432 0 20C0 31.0456 8.95434 40 20 40V31.2316C13.7931 31.2091 8.76825 26.1705 8.76825 19.9582C8.76825 13.7321 13.8156 8.68474 20.0418 8.68474C25.3044 8.68474 29.7248 12.2907 30.9669 17.1667H39.8008Z" fill="#fff"/>
  </svg>
</span>

<style>
  .logo-mark {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 28%;
    overflow: hidden;
    flex-shrink: 0;
    background: #1C1310;
  }

  .logo-poster,
  .logo-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Poster shows instantly; video paints over it the moment it has a frame
     ready, so the logo never blocks render and never flashes empty. */
  .logo-video { opacity: 0; transition: opacity var(--dur-short) var(--ease-out); }
  .logo-video.is-ready { opacity: 1; }

  .logo-glyph {
    position: relative;
    width: 58%;
    height: 58%;
    z-index: 1;
  }

  /* Reduced motion: video is paused + hidden by script (see below),
     poster stays as the permanent static mark. */
  @media (prefers-reduced-motion: reduce) {
    .logo-video { display: none; }
  }
</style>

<script>
  function initLogoVideos() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLVideoElement>('.logo-video').forEach((v) => {
      if (reduce) {
        v.pause();
        v.removeAttribute('autoplay');
        return;
      }
      if (v.readyState >= 2) {
        v.classList.add('is-ready');
      } else {
        v.addEventListener('loadeddata', () => v.classList.add('is-ready'), { once: true });
      }
    });
  }
  document.addEventListener('astro:page-load', initLogoVideos);
</script>
