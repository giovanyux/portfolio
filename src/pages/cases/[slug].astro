---
import { getCollection } from 'astro:content';
import CaseLayout from '@/layouts/CaseLayout.astro';

export async function getStaticPaths() {
  const all = await getCollection('cases', ({ data }) => !data.draft && !data.comingSoon);
  const sorted = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return sorted.map((entry, i) => {
    const next = sorted[(i + 1) % sorted.length];
    return {
      params: { slug: entry.slug },
      props: {
        entry,
        next: next.slug !== entry.slug
          ? { title: next.data.title, slug: next.slug, tag: next.data.tags[0] ?? 'PRODUTO' }
          : undefined,
      },
    };
  });
}

const { entry, next } = Astro.props;
const { Content } = await entry.render();
---

<CaseLayout
  title={entry.data.title}
  description={entry.data.description}
  cover={entry.data.cover}
  coverVideo={entry.data.coverVideo}
  tags={entry.data.tags}
  metric={entry.data.metric}
  metricLabel={entry.data.metricLabel}
  client={entry.data.client}
  role={entry.data.role}
  industry={entry.data.industry}
  platform={entry.data.platform}
  duration={entry.data.duration}
  year={entry.data.year}
  next={next}
>
  <Content />
</CaseLayout>
