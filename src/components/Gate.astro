---
import { SOCIAL } from '@/consts';
---

<div
  data-reveal="scroll"
  style="margin-top: 5rem; padding: 2.5rem; border: 1px solid var(--border); background: var(--muted);"
>
  <p style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.14em; color: var(--accent); text-transform: uppercase; margin-bottom: 1rem; font-weight: 700;">
    Quer ir mais fundo?
  </p>
  <p style="font-family: var(--font-sans); font-size: 1.0625rem; line-height: 1.7; color: var(--foreground); max-width: 60ch; margin-bottom: 1.5rem;">
    A versão completa do case cobre o processo de pesquisa, as métricas e as
    decisões por trás do design. Me chama que eu envio.
  </p>
  <a
    href={SOCIAL.email}
    class="underline-hover"
    style="font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; color: var(--foreground); text-decoration: none; text-transform: uppercase;"
  >
    Pedir a versão completa →
  </a>
</div>