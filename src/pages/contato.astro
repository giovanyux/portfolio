---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GridLines from '@/components/GridLines.astro';
import { AUTHOR, SOCIAL } from '@/consts';
---

<BaseLayout
  title="Contato — Giovany Jr"
  description="Entre em contato com Giovany Jr, Lead Product Designer. Aberto a posições sênior/lead e projetos interessantes."
>

  <!-- ── HERO ──────────────────────────────────────────── -->
  <section style="position: relative; overflow: hidden; padding: 5rem 2rem 5rem; max-width: 1200px; margin: 0 auto;">
    <GridLines />
    <div style="position: relative; z-index: var(--z-base); max-width: 700px;">
      <p data-reveal="hero" style="font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: var(--space-md);">
        CONTATO
      </p>
      <h1 data-reveal="hero" style="font-family: var(--font-display); font-size: var(--text-display); font-weight: 600; letter-spacing: -0.03em; line-height: 1; margin-bottom: var(--space-lg); transition-delay: 100ms;">
        Vamos conversar.
      </h1>
      <p data-reveal="hero" style="font-family: var(--font-sans); font-size: 1rem; color: var(--muted-foreground); line-height: 1.65; max-width: 50ch; margin-bottom: var(--space-sm); transition-delay: 180ms;">
        Estou em busca de posições sênior ou lead em product design — preferencialmente remote-first, com complexidade real de produto.
      </p>
      <p data-reveal="hero" style="font-family: var(--font-sans); font-size: 1rem; color: var(--muted-foreground); line-height: 1.65; max-width: 50ch; transition-delay: 260ms;">
        Se você tem um produto que precisa de um designer que entrega e pensa em sistemas — adoraria saber mais.
      </p>
    </div>
  </section>

  <!-- ── CANAIS ─────────────────────────────────────────── -->
  <section style="max-width: 1200px; margin: 0 auto; padding: 0 2rem var(--space-2xl);">
    <div style="border-top: 1px solid var(--border);">

      <a
        href={SOCIAL.email}
        style="display: flex; align-items: center; justify-content: space-between; padding: var(--space-md) 0; border-bottom: 1px solid var(--border); text-decoration: none; gap: var(--space-md); transition: color var(--dur-short) var(--ease-out);"
        class="contact-link"
      >
        <div>
          <p style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 0.3rem;">EMAIL</p>
          <p style="font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; color: var(--foreground);">{AUTHOR.email}</p>
        </div>
        <span style="font-family: var(--font-mono); font-size: 1.15rem; color: var(--muted-foreground); transition: color var(--dur-short) var(--ease-out), transform var(--dur-short) var(--ease-out);" class="contact-arrow">→</span>
      </a>

      <a
        href={SOCIAL.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        style="display: flex; align-items: center; justify-content: space-between; padding: var(--space-md) 0; border-bottom: 1px solid var(--border); text-decoration: none; gap: var(--space-md); transition: color var(--dur-short) var(--ease-out);"
        class="contact-link"
      >
        <div>
          <p style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 0.3rem;">LINKEDIN</p>
          <p style="font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; color: var(--foreground);">/in/giovany-jr-617223aa</p>
        </div>
        <span style="font-family: var(--font-mono); font-size: 1.15rem; color: var(--muted-foreground); transition: color var(--dur-short) var(--ease-out), transform var(--dur-short) var(--ease-out);" class="contact-arrow">→</span>
      </a>

      <a
        href={SOCIAL.github}
        target="_blank"
        rel="noopener noreferrer"
        style="display: flex; align-items: center; justify-content: space-between; padding: var(--space-md) 0; border-bottom: 1px solid var(--border); text-decoration: none; gap: var(--space-md); transition: color var(--dur-short) var(--ease-out);"
        class="contact-link"
      >
        <div>
          <p style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 0.3rem;">GITHUB</p>
          <p style="font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; color: var(--foreground);">@giovanyux</p>
        </div>
        <span style="font-family: var(--font-mono); font-size: 1.15rem; color: var(--muted-foreground); transition: color var(--dur-short) var(--ease-out), transform var(--dur-short) var(--ease-out);" class="contact-arrow">→</span>
      </a>

    </div>
  </section>

</BaseLayout>

<style>
  .contact-link:hover { color: var(--accent); }
  .contact-link:hover p { color: var(--accent); }
  .contact-link:hover .contact-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }
</style>
