---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GridLines from '@/components/GridLines.astro';
import CaseListItem from '@/components/CaseListItem.astro';
import { CREDENTIALS, BASE } from '@/consts';
import { getCollection } from 'astro:content';

const allCases = await getCollection('cases', ({ data }) => !data.draft);
const cases = allCases.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Copy EN pronta pro toggle de idioma, quando existir (nenhum toggle ativo
// hoje — o antigo foi removido por ficar inerte). Ver design.md.
// EN — mesma hierarquia em dois tempos (entrada / punch):
//   Product design that speaks
//   the language of the business
---

<BaseLayout>

  <!-- ── MARQUEE HERO ──────────────────────────────────── -->
  <section style="position: relative;">
    <!-- Glow: full-bleed layer, sibling to (not inside) the max-width
         content wrapper below — this is what makes it span the whole
         viewport instead of just the 1200px content column, which was
         the actual bug causing the vertical seams at the column edges. -->
    <GridLines glow lines={false} />
    <div style="position: relative; z-index: var(--z-base); padding: 6rem 2rem 6rem; max-width: 1200px; margin: 0 auto;">
    <div class="home-hero-layout" style="display: grid; gap: var(--space-2xl); align-items: center;">
      <div class="home-hero-copy">

        <p
          data-reveal="hero"
          style="font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--space-md);"
        >
          LEAD PRODUCT DESIGNER · 09 ANOS
        </p>

        <h1 class="home-hero-headline">
          <span data-reveal="hero" class="home-hero-headline-in" style="transition-delay: 100ms;">Design de produto que&nbsp;fala</span>
          <span data-reveal="hero" class="home-hero-headline-punch" style="transition-delay: 180ms;">a língua do&nbsp;negócio</span>
        </h1>

        <p
          data-reveal="hero"
          style="font-family: var(--font-sans); font-size: 1rem; color: var(--text-muted); max-width: 46ch; line-height: 1.65; margin-bottom: var(--space-lg); transition-delay: 260ms;"
        >
          9 anos desenhando SaaS B2B e B2C. Do Figma ao componente em produção, com IA no fluxo.
          Aberto a posições sênior/lead, remoto.
        </p>

        <div data-reveal="hero" style="display: flex; gap: var(--space-md); align-items: center; flex-wrap: wrap; transition-delay: 340ms;">
          <a href={`${BASE}/cases`} class="btn-pill-primary">
            Ver trabalhos →
          </a>
          <a href={`${BASE}/contato`} class="btn-ghost">
            Entrar em contato →
          </a>
        </div>
      </div>

      <div data-reveal="hero" class="home-hero-art" style="transition-delay: 200ms;">
        <figure class="hero-artifact">
          <img
            src={`${BASE}/cases/case-dionisio/cover.webp`}
            alt="Capa do case Dionísio: admin do gerente e app do garçom, produto real entregue"
            width="1800"
            height="945"
            loading="eager"
          />
        </figure>
      </div>
    </div>
    </div>
  </section>

  <style>
    /* Ancoragem à esquerda: o texto sempre começa na mesma margem do logo
       no header (mesmo container/padding), sem max-width fixo em px que
       sobre espaço morto à esquerda em telas largas — o limite de leitura
       vem de `ch` no parágrafo, não de uma caixa flutuando no meio da coluna. */
    .home-hero-copy {
      text-align: left;
      max-width: 44rem;
    }

    .home-hero-layout {
      grid-template-columns: 1fr;
    }

    @media (min-width: 960px) {
      .home-hero-layout { grid-template-columns: 1fr 0.82fr; }
    }

    /* Headline em dois tempos: entrada menor (--text) travada em cima da
       frase-punch grande (--action), que é o maior elemento do hero. */
    .home-hero-headline {
      font-family: var(--font-display);
      margin-bottom: var(--space-lg);
    }

    .home-hero-headline-in,
    .home-hero-headline-punch {
      display: block;
      text-wrap: balance;
    }

    .home-hero-headline-in {
      font-size: clamp(1.4rem, 1.3vw + 1.05rem, 3rem);
      font-weight: 600;
      color: var(--text);
      line-height: 1.05;
      letter-spacing: -0.01em;
    }

    .home-hero-headline-punch {
      font-size: clamp(2.75rem, 4vw + 2rem, 6rem);
      font-weight: 700;
      color: var(--action);
      line-height: 0.98;
      letter-spacing: -0.02em;
    }

    .btn-pill-primary {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2xs);
      font-family: var(--font-sans);
      font-size: 0.85rem;
      font-weight: 700;
      padding: 0.75rem 1.5rem;
      border-radius: 999px;
      background: var(--text);
      color: var(--bg);
      text-decoration: none;
      white-space: nowrap;
      transition: opacity var(--dur-micro) var(--ease-out), transform var(--dur-micro) var(--ease-out);
    }
    .btn-pill-primary:hover { opacity: 0.85; }
    .btn-pill-primary:active { transform: translateY(1px); }

    .btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2xs);
      font-family: var(--font-sans);
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.75rem 0.25rem;
      color: var(--text-muted);
      text-decoration: none;
      white-space: nowrap;
      transition: color var(--dur-short) var(--ease-out);
    }
    .btn-ghost:hover { color: var(--text); }

    .hero-artifact {
      margin: 0;
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--border);
      transform: rotate(-1.5deg);
      box-shadow: 0 28px 56px -24px color-mix(in oklch, var(--text) 45%, transparent);
    }

    .hero-artifact img {
      display: block;
      width: 100%;
      height: auto;
    }

    @media (max-width: 640px) {
      .hero-artifact { transform: none; }
    }
  </style>

  <!-- ── CREDENTIALS STRIP ─────────────────────────────── -->
  <div style="border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: var(--space-sm) 0;">
    <div style="display: flex; align-items: center;">
      <span style="font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; color: var(--text-muted); text-transform: uppercase; padding: 0 2rem; flex-shrink: 0; white-space: nowrap;">
        Anteriormente em
      </span>
      <div class="marquee-viewport" style="overflow: hidden; flex: 1; min-width: 0;">
        <div class="marquee-track" style="gap: var(--space-2xl); display: flex; align-items: center;">
          {[...CREDENTIALS, ...CREDENTIALS].map((name) => (
            <span style="font-family: var(--font-mono); font-size: 0.6rem; font-weight: 600; letter-spacing: 0.1em; color: var(--text-muted); text-transform: uppercase; flex-shrink: 0; opacity: 0.85;">
              {name}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- ── TRABALHOS SELECIONADOS — portfolio grid ─────────── -->
  <section style="max-width: 1200px; margin: 0 auto; padding: var(--space-2xl) 2rem 0;">
    <p style="font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--space-lg);">
      Trabalhos selecionados
    </p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-md);">
      {cases.map((c, i) => (
        <CaseListItem
          number={String(i + 1).padStart(2, '0')}
          tag={c.data.tags[0] ?? 'PRODUTO'}
          title={c.data.title}
          subtitle={c.data.description}
          cover={c.data.cover}
          thumbnail={c.data.thumbnail}
          coverVideo={c.data.coverVideo}
          metric={c.data.metric}
          slug={c.slug}
          index={i}
          comingSoon={c.data.comingSoon}
        />
      ))}
    </div>
  </section>

  <!-- ── CTA FINAL ──────────────────────────────────────── -->
  <section style="max-width: 1200px; margin: 0 auto; padding: var(--space-2xl) 2rem;">
    <div data-reveal="scroll" class="result-card" style="padding: var(--space-xl) var(--space-lg);">
      <p class="result-card-label" style="font-family: var(--font-sans); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--space-sm);">
        Vamos conversar
      </p>
      <h2 style="font-family: var(--font-display); font-size: clamp(1.75rem, 4.5vw, 3rem); font-weight: 600; color: var(--text); margin-bottom: var(--space-lg); line-height: 1.15; max-width: 18ch;">
        Aberto a posições sênior/lead, remoto.
      </h2>
      <a
        href={`${BASE}/contato`}
        class="btn-primary"
      >
        Entrar em contato →
      </a>
    </div>
  </section>

</BaseLayout>
