---
import BaseLayout from './BaseLayout.astro';
import Gate from '@/components/Gate.astro';
import NextCase from '@/components/NextCase.astro';
import { BASE } from '@/consts';

interface Props {
  title: string;
  description: string;
  cover: string;
  coverVideo?: string;
  tags: string[];
  metric: string;
  metricLabel?: string;
  client: string;
  role: string;
  industry?: string;
  platform?: string;
  duration: string;
  year: number;
  next?: { title: string; slug: string; tag: string };
}

const {
  title, description, cover, coverVideo, tags, metric, metricLabel,
  client, role, industry, platform, duration, year, next,
} = Astro.props;
---

<BaseLayout title={`${title} — Giovany Jr`} description={description} ogImage={`${BASE}${cover}`} type="article">
  <div style="max-width: 900px; margin: 0 auto; padding: 0 2rem;">

    <!-- Breadcrumb -->
    <nav
      aria-label="Breadcrumb"
      data-reveal="hero"
      style="padding: 2rem 0 1.5rem; font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; color: var(--muted-foreground); display: flex; align-items: center; gap: 0.5rem; text-transform: uppercase;"
    >
      <a href={`${BASE}/`} style="color: var(--muted-foreground); text-decoration: none;" class="underline-hover">Home</a>
      <span style="opacity: 0.4;">/</span>
      <a href={`${BASE}/cases`} style="color: var(--muted-foreground); text-decoration: none;" class="underline-hover">Cases</a>
      <span style="opacity: 0.4;">/</span>
      <span style="color: var(--foreground);">{title}</span>
    </nav>

    <!-- Tags + year -->
    <div data-reveal="hero" style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
      {tags.map((tag) => (
        <span style="font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.12em; color: var(--muted-foreground); text-transform: uppercase;">
          {tag}
        </span>
      ))}
      <span style="color: var(--border);">·</span>
      <span style="font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; color: var(--accent); font-weight: 700;">{year}</span>
    </div>

    <!-- Title -->
    <h1
      data-reveal="hero"
      style="font-family: var(--font-mono); font-size: clamp(2.5rem, 7vw, 5.5rem); font-weight: 700; line-height: 1.0; letter-spacing: -0.03em; color: var(--foreground); margin-bottom: 1.5rem;"
    >
      {title}
    </h1>

    <!-- Description -->
    <p
      data-reveal="hero"
      style="font-family: var(--font-mono); font-size: 1rem; color: var(--muted-foreground); line-height: 1.7; margin-bottom: 2.5rem; max-width: 56ch;"
    >
      {description}
    </p>

    <!-- Meta grid: Empresa · Papel · Indústria · Plataforma · Duração · Ano -->
    <div
      data-reveal="hero"
      class="meta-grid"
      style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border: 1px solid var(--border); margin-bottom: 3rem;"
    >
      {[
        { label: 'EMPRESA', value: client },
        { label: 'PAPEL', value: role },
        { label: 'INDÚSTRIA', value: industry ?? '—' },
        { label: 'PLATAFORMA', value: platform ?? '—' },
        { label: 'DURAÇÃO', value: duration },
        { label: 'ANO', value: String(year) },
      ].map(({ label, value }, i) => (
        <div style={`padding: 1.25rem; border-right: ${i % 3 < 2 ? '1px solid var(--border)' : 'none'}; border-top: ${i > 2 ? '1px solid var(--border)' : 'none'};`}>
          <p style="font-family: var(--font-mono); font-size: 0.55rem; letter-spacing: 0.14em; color: var(--muted-foreground); text-transform: uppercase; margin-bottom: 0.375rem;">{label}</p>
          <p style="font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700; color: var(--foreground); line-height: 1.3;">{value}</p>
        </div>
      ))}
    </div>

    <style>
      @media (max-width: 639px) {
        .meta-grid { grid-template-columns: repeat(2, 1fr) !important; }
      }
    </style>

    <!-- Hero image / video -->
    <div
      data-reveal="scroll"
      class="img-placeholder"
      style="width: 100%; aspect-ratio: 16/9; margin-bottom: 0.5rem;"
    >
      {coverVideo ? (
        <video
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          poster={BASE + cover}
          aria-label={`Demo animada do redesign: ${title}`}
          class="cover-media"
        >
          <source src={BASE + coverVideo} type="video/mp4" />
          <img src={BASE + cover} alt={`${title} — hero image`} class="cover-media" />
        </video>
      ) : (
        <img
          src={BASE + cover}
          alt={`${title} — hero image`}
          class="cover-media"
          onerror="this.style.display='none';"
        />
      )}
      <span>{title} — hero screenshot</span>
    </div>
    <p style="font-family: var(--font-mono); font-size: 0.6rem; color: var(--muted-foreground); letter-spacing: 0.06em; margin-bottom: 3rem; text-align: center;">
      Fig. 01 — {title}
    </p>

    <!-- Resultado: número grande + legenda -->
    <div
      data-reveal="scroll"
      style="border-left: 2px solid var(--accent); padding: 1.25rem 1.5rem; margin-bottom: 4rem; background: color-mix(in srgb, var(--accent) 4%, transparent);"
    >
      <p style="font-family: var(--font-mono); font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: var(--foreground); letter-spacing: -0.02em; line-height: 1.1;">{metric}</p>
      {metricLabel && (
        <p style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted-foreground); margin-top: 0.5rem;">{metricLabel}</p>
      )}
    </div>

    <!-- Markdown content -->
    <article class="prose">
      <slot />
    </article>

    <!-- [GATE] fixo -->
    <Gate />

    <!-- [PROXIMO] -->
    {next && <NextCase title={next.title} slug={next.slug} tag={next.tag} />}
  </div>
</BaseLayout>

<style>
  .cover-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
    z-index: 2;
  }
</style>

<script>
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('video[autoplay]').forEach((v) => {
      (v as HTMLVideoElement).removeAttribute('autoplay');
      (v as HTMLVideoElement).pause();
    });
  }
</script>
