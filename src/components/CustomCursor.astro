---
// Cursor autoral: uma bola que INVERTE o que está embaixo dela (backdrop-filter:
// invert(1), com fallback mix-blend-mode: difference). Auto-contrastante em
// qualquer fundo — creme, gradiente, card escuro, texto — de propósito não
// leva cor de marca por cima. Sobre card de case vira rótulo "Ver case →".
// Só (pointer: fine) and (hover: hover) — em touch fica 100% desligado.
---

<div id="custom-cursor" class="custom-cursor" aria-hidden="true" transition:persist>
  <span class="custom-cursor-ball"></span>
  <span class="custom-cursor-label"></span>
</div>

<style>
  .custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: var(--z-toast);
    pointer-events: none;
    transform: translate3d(-100px, -100px, 0);
    will-change: transform;
  }

  .custom-cursor-ball {
    position: absolute;
    top: 0;
    left: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
    will-change: transform, backdrop-filter;
    transition: transform 150ms var(--ease-out), opacity 150ms var(--ease-out),
                width 150ms var(--ease-out), height 150ms var(--ease-out);
  }

  /* Técnica ativa decidida em JS (feature detection), vira classe no <html>.
     Preferida: inversão real do que está embaixo. */
  :global(html.cursor-invert) .custom-cursor-ball {
    backdrop-filter: invert(1);
    -webkit-backdrop-filter: invert(1);
    background: transparent;
  }

  /* Fallback (sem suporte a backdrop-filter): círculo branco + difference,
     mesmo resultado visual de inversão, técnica mais barata/compatível. */
  :global(html.cursor-blend) .custom-cursor-ball {
    background: #fff;
    mix-blend-mode: difference;
  }

  .custom-cursor-label {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(-50%, -50%) scale(0.7);
    opacity: 0;
    white-space: nowrap;
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    transition: transform 180ms var(--ease-out), opacity 180ms var(--ease-out);
  }

  /* sobre link/botão genérico: cresce um pouco, sinaliza clicável */
  .custom-cursor.is-link .custom-cursor-ball {
    width: 38px;
    height: 38px;
  }

  /* sobre card de case / vitrine do hero: bola some, rótulo assume — aqui
     abre mão da inversão e usa --text sólido, fica mais legível como CTA. */
  .custom-cursor.is-case .custom-cursor-ball { opacity: 0; }
  .custom-cursor.is-case .custom-cursor-label {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  /* clique: encolhe, discreto */
  .custom-cursor.is-active .custom-cursor-ball {
    transform: translate(-50%, -50%) scale(0.8);
  }

  /* sobre texto: cursor custom some por completo — o nativo (I-beam) assume,
     ver a regra `cursor: auto !important` em global.css pros mesmos elementos. */
  .custom-cursor.is-text .custom-cursor-ball,
  .custom-cursor.is-text .custom-cursor-label {
    opacity: 0;
  }

  /* reduced-motion: a bola continua seguindo o mouse (é posição, não
     decoração), mas sem transições suaves e sem a micro-animação de clique. */
  @media (prefers-reduced-motion: reduce) {
    .custom-cursor-ball,
    .custom-cursor-label {
      transition: none;
    }
    .custom-cursor.is-active .custom-cursor-ball {
      transform: translate(-50%, -50%) scale(1);
    }
  }
</style>

<script is:inline>
  (function () {
    if (window.__cursorInitialized) return;

    // Toque/sem hover: cursor nativo, sem exceção. Reduced-motion NÃO
    // desativa mais o cursor inteiro — só a micro-animação de clique (CSS).
    var canUseCustomCursor = window.matchMedia('(pointer: fine) and (hover: hover)').matches;
    if (!canUseCustomCursor) return;

    var cursor = document.getElementById('custom-cursor');
    if (!cursor) return;
    var label = cursor.querySelector('.custom-cursor-label');

    window.__cursorInitialized = true;

    // Feature detection: inversão real via backdrop-filter quando dá,
    // mix-blend-mode: difference como fallback (efeito visual equivalente).
    var supportsInvert =
      window.CSS &&
      CSS.supports &&
      (CSS.supports('backdrop-filter', 'invert(1)') || CSS.supports('-webkit-backdrop-filter', 'invert(1)'));
    document.documentElement.classList.add(supportsInvert ? 'cursor-invert' : 'cursor-blend');

    var TEXT_SELECTOR = 'p, h1, h2, h3, h4, h5, h6, li, blockquote, figcaption, label, td, th, dt, dd';
    var LINK_SELECTOR = 'a, button, [role="button"], summary, input, textarea, select';
    var CASE_SELECTOR = '.case-card-link, [data-cursor-label]';

    var rafId = null;
    var x = -100;
    var y = -100;

    function render() {
      cursor.style.transform = 'translate3d(' + x + 'px,' + y + 'px,0)';
      rafId = null;
    }

    function onMouseMove(e) {
      x = e.clientX;
      y = e.clientY;
      if (rafId === null) rafId = requestAnimationFrame(render);
    }

    function onPointerOver(e) {
      var caseEl = e.target.closest(CASE_SELECTOR);
      if (caseEl) {
        cursor.className = 'custom-cursor is-case';
        label.textContent = caseEl.getAttribute('data-cursor-label') || 'Ver case →';
        return;
      }
      var linkEl = e.target.closest(LINK_SELECTOR);
      if (linkEl) {
        cursor.className = 'custom-cursor is-link';
        return;
      }
      var textEl = e.target.closest(TEXT_SELECTOR);
      if (textEl && !textEl.closest(LINK_SELECTOR)) {
        cursor.className = 'custom-cursor is-text';
        return;
      }
      cursor.className = 'custom-cursor';
    }

    function onMouseDown() { cursor.classList.add('is-active'); }
    function onMouseUp() { cursor.classList.remove('is-active'); }
    function onMouseLeaveWindow() { x = -100; y = -100; render(); }

    document.addEventListener('mousemove', onMouseMove, { passive: true });
    document.addEventListener('pointerover', onPointerOver, { passive: true });
    document.addEventListener('mousedown', onMouseDown);
    document.addEventListener('mouseup', onMouseUp);
    document.addEventListener('mouseleave', onMouseLeaveWindow);

    // Só esconde o cursor nativo depois do custom estar garantido rodando —
    // se esse script nunca chegar até aqui (erro, JS bloqueado), o nativo
    // nunca some, ver `html.cursor-ready *` em global.css.
    document.documentElement.classList.add('cursor-ready');
  })();
</script>
